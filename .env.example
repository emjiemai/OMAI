# Copy to .env. Never commit .env.
DATABASE_URL=sqlite:///./omai.db          # postgresql://user:pass@host:5432/omai in production
TIMEZONE=Asia/Tashkent
RUN_SCHEDULER=false                       # true in exactly one process
SESSION_SECRET=change-me

# SAP Business One Service Layer — two users: read-only, and posting (approved adjustments only)
SAP_SL_URL=https://sap-server:50000/b1s/v1
SAP_COMPANY_DB=
SAP_READ_USER=
SAP_READ_PASSWORD=
SAP_POST_USER=
SAP_POST_PASSWORD=
SAP_VERIFY_TLS=true
SAP_PUSH_SECRET=                          # if the SAP gateway machine pushes to POST /sap/push instead

# 1C OData (read-only service user, role УдаленныйДоступOData)
ONEC_ODATA_URL=https://clobus.uz/a/acc313/XXXXX/odata/standard.odata/
ONEC_LOGIN=
ONEC_PASSWORD=
ONEC_BALANCE_ENTITY=AccumulationRegister_ТоварыНаСкладах/Balance
ONEC_ITEM_FIELD=Номенклатура_Key
ONEC_WAREHOUSE_FIELD=Склад_Key
ONEC_QTY_FIELD=КоличествоBalance

# Billz 2.0 (Настройки → Компания → Ключи интеграции)
BILLZ_SECRET_TOKEN=
BILLZ_STOCK_PATH=/v2/products             # verify with Billz for your plan

# Messaging and other agents
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CASH_WEBHOOK_SECRET=
AIPRO_WEBHOOK_URL=
MIYA_WEBHOOK_URL=

# Policy starting values (approved policy overrides)
SYNC_STALE_MINUTES=60
COUNT_TOLERANCE_UNITS=0
ADJUSTMENT_LIMIT_MANAGER=5000000
ADJUSTMENT_LIMIT_ACCOUNTANT=50000000
