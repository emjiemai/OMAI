# OMAI reads only these (from the shared environment group). Copy to .env locally; never commit .env.
DATABASE_URL=sqlite:///./omai.db      # set by Render from the attached database
ENVIRONMENT=development                # production = the daily schedule runs (only on the server)
DRY_RUN=false                         # true = nothing is sent out
TZ=Asia/Tashkent
SAP_PUSH_WEBHOOK_SECRET=              # the SAP gateway machine pushes to POST /sap/push
ONEC_ODATA_URL=https://clobus.uz/a/acc313/61458/odata/standard.odata/
ONEC_LOGIN=
ONEC_PASSWORD=
BILLZ_SECRET_TOKEN=
TELEGRAM_PRIMARY_BOT_TOKEN=           # task messages and buttons
